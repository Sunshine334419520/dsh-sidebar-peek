{
  "name": "dsh-sidebar-peek",
  "version": "0.1.1",
  "description": "Edge-style hover peek for the DeepSeek Harness sidebar: it rests as an icon rail and expands while the pointer is on it.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "sidebar",
    "hover",
    "edge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sunshine334419520/dsh-sidebar-peek.git"
  },
  "homepage": "https://github.com/Sunshine334419520/dsh-sidebar-peek#readme",
  "bugs": {
    "url": "https://github.com/Sunshine334419520/dsh-sidebar-peek/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "docs/preview.html",
    "docs/preview.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
